# Copy to .env and fill in.

# Required: web search over recent news (https://tavily.com).
# NOT proxied by the gateway — always a REAL Tavily key.
TAVILY_API_KEY=your_tavily_api_key_here

# Model access — pick ONE:
#
# (a) Direct Anthropic (default): a real Anthropic key, no base URL.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
#
# (b) LangSmith LLM Gateway: one LangSmith key powers tracing AND model calls, so
#     no separate provider key is needed. Set the base URL and point the Anthropic
#     key at your LangSmith key (locally ${LANGSMITH_API_KEY} is expanded; on
#     LangSmith Deployment, LANGSMITH_API_KEY is injected automatically).
# ANTHROPIC_BASE_URL=https://gateway.smith.langchain.com/anthropic
# ANTHROPIC_API_KEY=${LANGSMITH_API_KEY}
#
# Swap which models are used in code: src/throughline/models.py (WORKER_MODEL / EDITOR_MODEL).

# Optional: tracing (https://smith.langchain.com)
# LANGSMITH_API_KEY=your_langsmith_api_key_here
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=throughline

# Optional: deliver the finished report to Slack (a Slack incoming webhook URL).
# Unset -> no delivery. Set as a deployment secret so scheduled runs post the report.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
