# Copy to .env and fill in.

# Required: web search over recent news (https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# Required: models (https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: tracing (https://smith.langchain.com)
# LANGSMITH_API_KEY=your_langsmith_api_key_here
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=throughline

# Optional: route model calls through the LangSmith LLM Gateway instead of calling
# Anthropic directly (one LangSmith key, any provider's model, centrally governed).
# Set ANTHROPIC_API_KEY above to your LangSmith key, then:
# ANTHROPIC_BASE_URL=https://gateway.smith.langchain.com
# THROUGHLINE_WORKER_MODEL=anthropic:anthropic/claude-haiku-4-5
# THROUGHLINE_EDITOR_MODEL=anthropic:anthropic/claude-sonnet-4-6
